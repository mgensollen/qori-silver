## Stripe (required)
# Get this from your Stripe Dashboard → Developers → API keys
STRIPE_SECRET_KEY=YOUR_STRIPE_SECRET_KEY_HERE

## Stripe webhooks (required to save orders)
# Create via Stripe CLI (recommended for local): `stripe listen --forward-to localhost:4242/api/stripe-webhook`
STRIPE_WEBHOOK_SECRET=whsec_XXXXXXXXXXXXXXXXXXXXXXXX

## Server
PORT=4242

## CORS (optional, recommended when frontend is on GitHub Pages)
# Example: https://mgensollen.github.io
# CORS_ORIGIN=https://your-username.github.io
CORS_ORIGIN=

