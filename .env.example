## Stripe (required)
# Get this from your Stripe Dashboard → Developers → API keys
STRIPE_SECRET_KEY=YOUR_STRIPE_SECRET_KEY_HERE

## Stripe webhooks (required to save orders)
# Create via Stripe CLI (recommended for local): `stripe listen --forward-to localhost:4242/api/stripe-webhook`
STRIPE_WEBHOOK_SECRET=whsec_XXXXXXXXXXXXXXXXXXXXXXXX

## Server
PORT=4242

## CORS (optional, recommended when frontend is on GitHub Pages)
# Example: https://mgensollen.github.io
# CORS_ORIGIN=https://your-username.github.io
CORS_ORIGIN=

## Supabase inventory (optional — replaces data/inventory.json)
# Create a project at https://supabase.com → Settings → API.
# Run SQL from supabase/migrations/001_product_inventory.sql in the SQL editor.
# Use the service_role key only on the server (never in the browser).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

## Images (Google Sheet Picture column)
# Comma-separated URLs: Google Drive file links, Cloudinary
# (https://res.cloudinary.com/.../image/upload/...), Supabase Storage public URLs,
# or any direct https image URL.

